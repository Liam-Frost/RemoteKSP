<UserControl x:Class="RemoteKSP.Server.Views.Dialogs.ClientPermissionsForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560" MaxWidth="640" MinWidth="480">
    <StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"/>

        <RadioButton Content="允许所有已分享的证书（包括以后新增的）" GroupName="Mode"
                     IsChecked="{Binding AllowAll}" Margin="0,0,0,8"/>
        <RadioButton Content="仅允许选中的证书" GroupName="Mode"
                     IsChecked="{Binding AllowAll, Converter={StaticResource InverseBoolConverter}}" Margin="0,0,0,8"/>

        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                Padding="12,8" Margin="28,0,0,0" MaxHeight="260"
                IsEnabled="{Binding AllowAll, Converter={StaticResource InverseBoolConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsShared}" Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Text="未分享的证书对所有客户端都不可用，需先在「证书管理」中开启分享。"
                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="28,8,0,0"/>
    </StackPanel>
</UserControl>
