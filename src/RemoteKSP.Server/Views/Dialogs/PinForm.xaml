<UserControl x:Class="RemoteKSP.Server.Views.Dialogs.PinForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RemoteKSP.Server.Localization"
             Width="480" MaxWidth="560" MinWidth="420">
    <StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,16"/>
        <TextBlock Text="PIN" FontSize="13" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PinBox" MaxWidth="300" HorizontalAlignment="Left"/>
        <TextBlock Text="{x:Static loc:Strings.X_PinFormInfo}"
                   Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
