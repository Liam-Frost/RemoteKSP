<UserControl x:Class="RemoteKSP.Server.Views.Dialogs.AddCertificateForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RemoteKSP.Server.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="600" MaxWidth="720" MinWidth="480">

    <StackPanel>
        <TextBlock Text="{x:Static loc:Strings.X_CertSource}" FontSize="13" Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,16">
            <RadioButton Content="{x:Static loc:Strings.Type_Store}" GroupName="SourceType" Margin="0,0,16,0" IsChecked="{Binding IsStore}"/>
            <RadioButton Content="eToken" GroupName="SourceType" Margin="0,0,16,0" IsChecked="{Binding IsEToken}"/>
            <RadioButton Content="{x:Static loc:Strings.Type_Pfx}" GroupName="SourceType" Margin="0,0,16,0" IsChecked="{Binding IsPfx}"/>
            <RadioButton Content="{x:Static loc:Strings.Type_Test}" GroupName="SourceType" IsChecked="{Binding IsTest}"/>
        </WrapPanel>

        <TextBlock Text="{x:Static loc:Strings.Common_Name}" FontSize="13" Margin="0,0,0,4"/>
        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{x:Static loc:Strings.X_NamePlaceholder}" Margin="0,0,0,16"/>

        <!-- 证书存储 -->
        <StackPanel Visibility="{Binding IsStore, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static loc:Strings.X_StoreLocation}" FontSize="13" Margin="0,0,0,4"/>
            <ComboBox SelectedValue="{Binding StoreLocation}" SelectedValuePath="Tag"
                      HorizontalAlignment="Left" MinWidth="280" Margin="0,0,0,12">
                <ComboBoxItem Content="{x:Static loc:Strings.X_StoreLocalMachine}" Tag="LocalMachine"/>
                <ComboBoxItem Content="{x:Static loc:Strings.X_StoreCurrentUser}" Tag="CurrentUser"/>
            </ComboBox>

            <ui:InfoBar IsOpen="{Binding IsCurrentUserStore}" Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                        Title="{x:Static loc:Strings.X_UseLocalMachineTitle}"
                        Message="{x:Static loc:Strings.X_UseLocalMachine}"/>

            <TextBlock Text="{x:Static loc:Strings.X_Certificate}" FontSize="13" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding StoreCertificates}" SelectedItem="{Binding SelectedStoreCertificate}"
                          DisplayMemberPath="Display"/>
                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0" ToolTip="{x:Static loc:Strings.X_Reload}"
                           Command="{Binding LoadStoreCertificatesCommand}"/>
            </Grid>
            <TextBlock Text="{Binding SelectedStoreCertificate.Thumbprint}" Style="{StaticResource MonospaceTextStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding StoreStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- eToken -->
        <StackPanel Visibility="{Binding IsEToken, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static loc:Strings.X_CspProvider}" FontSize="13" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding CspProvider}" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static loc:Strings.X_KeyContainer}" FontSize="13" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox IsEditable="True" ItemsSource="{Binding Containers}"
                          Text="{Binding KeyContainer, UpdateSourceTrigger=PropertyChanged}"/>
                <ui:Button Grid.Column="1" Content="{x:Static loc:Strings.X_DetectEToken}" Margin="8,0,0,0"
                           Command="{Binding DetectContainersCommand}"/>
            </Grid>
            <TextBlock Text="{Binding DetectStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static loc:Strings.X_ThumbprintLocalMachine}" FontSize="13" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding EtokenThumbprint}" FontFamily="Cascadia Mono, Consolas" Margin="0,0,0,12"/>

            <TextBlock Text="{x:Static loc:Strings.X_PinOptional}" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PinBox" MaxWidth="300" HorizontalAlignment="Left" PasswordChanged="PinBox_PasswordChanged"/>
        </StackPanel>

        <!-- PFX -->
        <StackPanel Visibility="{Binding IsPfx, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{x:Static loc:Strings.Type_Pfx}" FontSize="13" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding PfxPath}" IsReadOnly="True"/>
                <ui:Button Grid.Column="1" Content="{x:Static loc:Strings.X_Browse}" Margin="8,0,0,0" Command="{Binding BrowsePfxCommand}"/>
            </Grid>

            <TextBlock Text="{x:Static loc:Strings.X_PfxPassword}" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PfxPasswordBox" MaxWidth="300" HorizontalAlignment="Left" Margin="0,0,0,12"
                         PasswordChanged="PfxPasswordBox_PasswordChanged"/>

            <ui:Button Content="{x:Static loc:Strings.X_GenerateTestPfx}" Command="{Binding GenerateTestPfxCommand}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding PfxStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 测试证书 -->
        <ui:InfoBar IsOpen="{Binding IsTest}" Severity="Informational" IsClosable="False"
                    Title="{x:Static loc:Strings.Type_Test}"
                    Message="{x:Static loc:Strings.X_TestCertInfo}"/>

        <CheckBox Content="{x:Static loc:Strings.X_ShareWithClients}" IsChecked="{Binding IsShared}" Margin="0,16,0,0"/>
    </StackPanel>
</UserControl>
