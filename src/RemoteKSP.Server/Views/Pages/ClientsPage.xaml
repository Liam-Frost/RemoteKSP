<Page x:Class="RemoteKSP.Server.Views.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:RemoteKSP.Server.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area (scrollable) -->
        <Grid Grid.Row="0">
            <!-- Table with data -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ViewModel.HasClients, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Padding="0" VerticalAlignment="Top">
                    <DataGrid ItemsSource="{Binding ViewModel.Clients, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedClient, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.Common_ClientId}" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"
                                                   FontFamily="Consolas, Cascadia Mono" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.Common_MachineName}" Binding="{Binding MachineName}" Width="160"/>
                            <DataGridTextColumn Header="{x:Static loc:Strings.Common_IpAddress}" Binding="{Binding IpAddress}" Width="130"/>
                            <DataGridTextColumn Header="{x:Static loc:Strings.X_CertPermissions}" Binding="{Binding PermissionText}" Width="120"/>
                            <DataGridTextColumn Header="{x:Static loc:Strings.X_PairedAt}" Binding="{Binding PairedAtStr}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="{x:Static loc:Strings.X_LastSeen}" Binding="{Binding LastSeenStr}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ViewModel.HasClients, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="People24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding ViewModel.EmptyText, RelativeSource={RelativeSource AncestorType=Page}}"
                           FontSize="14" Margin="0,16,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.X_ClientsEmptyHint}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar (fixed at bottom) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Content="{x:Static loc:Strings.Clients_PermissionsTitle}" Icon="{ui:SymbolIcon ShieldKeyhole24}" Margin="0,0,8,0"
                               Command="{Binding ViewModel.ManagePermissionsCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="{x:Static loc:Strings.X_RevokeClient}"
                               Command="{Binding ViewModel.RevokeCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </StackPanel>
                <ui:Button Content="{x:Static loc:Strings.Common_Refresh}" Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Right"
                           Command="{Binding ViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
