<Page x:Class="RemoteKSP.Server.Views.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:RemoteKSP.Server.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:net="clr-namespace:RemoteKSP.Shared.Networking;assembly=RemoteKSP.Shared"
      xmlns:sharedui="clr-namespace:RemoteKSP.Shared.Ui;assembly=RemoteKSP.Shared"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <!-- 页面标题「概览」由窗口标题行显示；「刷新状态」放在同一行右侧，重新查询服务、密钥源和客户端 -->
    <sharedui:PageHeader.Actions>
        <ui:Button Content="{x:Static loc:Strings.X_RefreshStatus}" Icon="{ui:SymbolIcon ArrowSync20}"
                   Command="{Binding ViewModel.RefreshStatusCommand}"/>
    </sharedui:PageHeader.Actions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource OverviewPagePadding}">

            <!-- 第一层：Windows 服务（全宽），状态来自 Service Control Manager -->
            <sharedui:MetricCard Symbol="Server24" Title="{x:Static loc:Strings.X_WindowsService}" IsWide="True"
                                 Margin="{StaticResource OverviewSectionMargin}"
                                 Value="{Binding ViewModel.ServiceValue, RelativeSource={RelativeSource AncestorType=Page}}"
                                 Detail="{Binding ViewModel.ServiceDetail, RelativeSource={RelativeSource AncestorType=Page}}"
                                 Status="{Binding ViewModel.ServiceIndicator, RelativeSource={RelativeSource AncestorType=Page}}">
                <sharedui:MetricCard.Actions>
                    <StackPanel Orientation="Horizontal">
                        <!-- 只显示当前状态下可用的主操作；执行期间命令禁用 -->
                        <ui:Button Content="{x:Static loc:Strings.X_Install}" Icon="{ui:SymbolIcon Add20}" Appearance="Primary"
                                   Command="{Binding ViewModel.InstallServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   Visibility="{Binding ViewModel.CanInstallService, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="{x:Static loc:Strings.X_Start}" Icon="{ui:SymbolIcon Play20}" Appearance="Primary"
                                   Command="{Binding ViewModel.StartServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   Visibility="{Binding ViewModel.CanStartService, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ui:Button Content="{x:Static loc:Strings.X_Stop}" Icon="{ui:SymbolIcon Stop20}"
                                   Command="{Binding ViewModel.StopServiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                   Visibility="{Binding ViewModel.CanStopService, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <!-- 低频破坏性操作放进「更多」菜单，点击后仍有确认对话框 -->
                        <!-- 不用 ui:DropDownButton：它只响应鼠标抬起，键盘和辅助技术打不开菜单 -->
                        <!-- MetricCard 是 UserControl，内容里不能用 x:Name；处理函数用 sender，自动化/测试用 AutomationId 定位 -->
                        <ui:Button Margin="8,0,0,0" Padding="8,6" ToolTip="{x:Static loc:Strings.X_MoreActions}"
                                   Icon="{ui:SymbolIcon MoreHorizontal20}"
                                   AutomationProperties.Name="{x:Static loc:Strings.X_MoreActions}"
                                   AutomationProperties.AutomationId="ServiceMoreButton"
                                   Click="OnMoreClick"
                                   Visibility="{Binding ViewModel.ServiceInstalled, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{x:Static loc:Strings.X_UninstallService}"
                                              Icon="{ui:SymbolIcon Delete20}"
                                              Command="{Binding PlacementTarget.DataContext.ViewModel.UninstallServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </sharedui:MetricCard.Actions>
            </sharedui:MetricCard>

            <!-- 第二层：签名密钥源 + 已授权客户端（宽时两列，窄时单列） -->
            <sharedui:ResponsiveColumnsPanel MaxColumns="2" MinColumnWidth="300"
                                             ColumnSpacing="{StaticResource OverviewCardSpacing}"
                                             RowSpacing="{StaticResource OverviewCardSpacing}"
                                             Margin="{StaticResource OverviewSectionMargin}">
                <!-- 只在服务确实运行、管理通道确实回复后才判断就绪；通道失败显示「无法获取」而不是「服务未运行」 -->
                <sharedui:MetricCard Symbol="Certificate24" Title="{x:Static loc:Strings.X_SigningKeySource}"
                                     Value="{Binding ViewModel.KeySourceValue, RelativeSource={RelativeSource AncestorType=Page}}"
                                     Detail="{Binding ViewModel.KeySourceDetail, RelativeSource={RelativeSource AncestorType=Page}}"
                                     DetailToolTip="{Binding ViewModel.KeySourceToolTip, RelativeSource={RelativeSource AncestorType=Page}}"
                                     Status="{Binding ViewModel.KeySourceIndicator, RelativeSource={RelativeSource AncestorType=Page}}">
                    <sharedui:MetricCard.Actions>
                        <ui:Button Icon="{ui:SymbolIcon ArrowRight16}" Content="{x:Static loc:Strings.X_ManageCertificates}"
                                   Command="{Binding ViewModel.OpenCertificatesCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </sharedui:MetricCard.Actions>
                </sharedui:MetricCard>

                <sharedui:MetricCard Symbol="People24" Title="{x:Static loc:Strings.X_AuthorizedClients}"
                                     Value="{Binding ViewModel.ClientsValue, RelativeSource={RelativeSource AncestorType=Page}}"
                                     Detail="{Binding ViewModel.ClientsDetail, RelativeSource={RelativeSource AncestorType=Page}}"
                                     DetailToolTip="{Binding ViewModel.ClientsToolTip, RelativeSource={RelativeSource AncestorType=Page}}">
                    <sharedui:MetricCard.Actions>
                        <ui:Button Icon="{ui:SymbolIcon ArrowRight16}"
                                   Content="{Binding ViewModel.ClientsActionText, RelativeSource={RelativeSource AncestorType=Page}}"
                                   Command="{Binding ViewModel.OpenClientsCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </sharedui:MetricCard.Actions>
                </sharedui:MetricCard>
            </sharedui:ResponsiveColumnsPanel>

            <!-- 第三层：网络地址（全宽） -->
            <net:NetworkAddressesCard DataContext="{Binding ViewModel.Network, RelativeSource={RelativeSource AncestorType=Page}}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
