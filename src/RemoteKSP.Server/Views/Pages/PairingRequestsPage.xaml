<Page x:Class="RemoteKSP.Server.Views.Pages.PairingRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area (scrollable) -->
        <Grid Grid.Row="0">
            <!-- Table with data -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ViewModel.HasRequests, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Padding="0" VerticalAlignment="Top">
                    <DataGrid ItemsSource="{Binding ViewModel.Requests, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedRequest, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="机器名" Binding="{Binding MachineName}" Width="150"/>
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding IpAddress}" Width="120"/>
                            <DataGridTextColumn Header="验证码" Binding="{Binding VerificationCode}" Width="100"/>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtStr}" Width="150"/>
                            <DataGridTextColumn Header="过期时间" Binding="{Binding ExpiresAtStr}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ViewModel.HasRequests, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="Clipboard24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding ViewModel.EmptyText, RelativeSource={RelativeSource AncestorType=Page}}"
                           FontSize="14" Margin="0,16,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="配对请求将在客户端发起连接时出现在此处"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar (fixed at bottom) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:Button Content="批准配对" Appearance="Primary" Margin="0,0,8,0"
                               Command="{Binding ViewModel.ApproveCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="拒绝配对"
                               Command="{Binding ViewModel.RejectCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </StackPanel>
                <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Right"
                           Command="{Binding ViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
