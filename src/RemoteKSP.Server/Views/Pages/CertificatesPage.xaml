<Page x:Class="RemoteKSP.Server.Views.Pages.CertificatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <Page.Resources>
        <!-- 状态徽标：与概览页"测试"徽标同一套配色 -->
        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="Success">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Caution">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKind}" Value="Success">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Caution">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content Area (scrollable) -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Table -->
                <ui:Card Padding="0" VerticalAlignment="Top"
                         Visibility="{Binding ViewModel.HasCertificates, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding ViewModel.Certificates, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="360"
                              GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="名称" Width="240" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <Border Background="#DBEAFE" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="旧版客户端（/info）只能获取默认证书">
                                                <TextBlock Text="默认" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="120"/>
                            <DataGridTemplateColumn Header="状态" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StateBadgeStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource StateBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="分享" Binding="{Binding SharedText}" Width="80"/>
                            <DataGridTextColumn Header="有效期至" Binding="{Binding ExpiryText}" Width="110"/>
                            <DataGridTemplateColumn Header="指纹" Width="*" MinWidth="320">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Thumbprint}"
                                                   FontFamily="Consolas, Cascadia Mono"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Thumbprint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>

                <!-- Empty State -->
                <Border MinHeight="300"
                        Visibility="{Binding ViewModel.HasCertificates, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Certificate24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding ViewModel.EmptyText, RelativeSource={RelativeSource AncestorType=Page}}"
                                   FontSize="14" Margin="0,16,0,8" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="添加 eToken、证书存储、PFX 或测试证书后，已配对的客户端即可获取并使用"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Selected certificate details -->
                <ui:Card Padding="20" Margin="0,16,0,0"
                         Visibility="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid DataContext="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="主题" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.Subject}" Style="{StaticResource PropertyValueTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="来源" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource PropertyValueTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="指纹" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Thumbprint, Mode=OneWay}" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="状态" Style="{StaticResource PropertyLabelTextStyle}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource PropertyValueTextStyle}" TextWrapping="Wrap"/>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Bar (fixed at bottom) -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <WrapPanel HorizontalAlignment="Left">
                    <ui:Button Content="添加证书" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,0,8,0"
                               IsEnabled="{Binding ViewModel.ServiceAvailable, RelativeSource={RelativeSource AncestorType=Page}}"
                               Command="{Binding ViewModel.AddCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="编辑" Margin="0,0,8,0"
                               Command="{Binding ViewModel.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="验证 PIN" Margin="0,0,8,0"
                               Command="{Binding ViewModel.SetPinCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="设为默认" Margin="0,0,8,0"
                               Command="{Binding ViewModel.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="删除"
                               Command="{Binding ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:Button Content="重新加载密钥源" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0"
                               ToolTip="让服务重新连接所有证书的密钥源（如插好 eToken 后），并重置自动重试次数"
                               IsEnabled="{Binding ViewModel.ServiceAvailable, RelativeSource={RelativeSource AncestorType=Page}}"
                               Command="{Binding ViewModel.ReloadKeySourcesCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding ViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
