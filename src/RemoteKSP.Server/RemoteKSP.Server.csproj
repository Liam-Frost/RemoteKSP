<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RemoteKSP.Server</AssemblyName>
    <Version>2.2.1</Version>
    <!-- UI languages shipped: our own zh-Hans satellite, and no other package translations -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\Shared\LOGO\RemoteKSP.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <InternalsVisibleTo Include="SecurityRegression" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows 通知的图标：通知进程把它写到 %LOCALAPPDATA%\RemoteKSP 后登记给 AppUserModelID -->
    <EmbeddedResource Include="..\Shared\LOGO\RemoteKSP_LOGO.png" LogicalName="RemoteKSP.Server.Notification.png" />
    <Resource Include="..\Shared\LOGO\RemoteKSP.ico">
      <Link>Assets\RemoteKSP.ico</Link>
    </Resource>
  </ItemGroup>

  <!-- UI text: Strings.resx is English, Strings.<culture>.resx are translations.
       Strings.Designer.cs is regenerated by Visual Studio / Rider when the .resx changes. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx"
                      Generator="PublicResXFileCodeGenerator" LastGenOutput="Strings.Designer.cs" />
    <Compile Update="Localization\Strings.Designer.cs"
             DesignTime="True" AutoGen="True" DependentUpon="Strings.resx" />
    <Using Include="RemoteKSP.Server.Localization" />
  </ItemGroup>

</Project>
