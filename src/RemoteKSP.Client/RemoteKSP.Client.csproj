<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RemoteKSP.Client</AssemblyName>
    <Version>2.1.2</Version>
    <ApplicationIcon>..\Shared\LOGO\RemoteKSP.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.22" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\native\ksp\RemoteKSP_x64.dll">
      <Link>RemoteKSP_x64.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\native\ksp\RemoteKSP_x86.dll">
      <Link>RemoteKSP_x86.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Shared\LOGO\RemoteKSP.ico">
      <Link>Assets\RemoteKSP.ico</Link>
    </Resource>
  </ItemGroup>

</Project>
