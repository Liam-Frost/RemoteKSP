<UserControl x:Class="RemoteKSP.Client.Views.Dialogs.SignToolCommandForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RemoteKSP.Client.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="680" MaxWidth="780" MinWidth="600">
    <!-- 不要再包 ScrollViewer：ContentDialog 模板的内容区自带一个，嵌套会在窗口较矮时出现两个滚动条 -->
    <StackPanel Margin="0,0,0,12">
        <!-- 执行期间禁用所有输入，保证执行的就是开始时预览里的那条命令 -->
        <StackPanel IsEnabled="{Binding IsInputEnabled}">
            <!-- 说明 -->
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static loc:Strings.X_StIntro}"/>

            <!-- 证书信息 -->
            <TextBlock Text="{x:Static loc:Strings.X_SigningCertificate}" Style="{StaticResource SectionHeaderTextStyle}"/>
            <ui:Card Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static loc:Strings.Srv_Name}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding CertName}" Style="{StaticResource PropertyValueTextStyle}"/>
                        <Border Padding="6,2" CornerRadius="3" Background="#FEE2E2" Margin="8,0,0,0"
                                Visibility="{Binding CertIsTest, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{x:Static loc:Strings.X_Test}" FontSize="11" Foreground="#991B1B"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static loc:Strings.X_Subject}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CertSubject}" FontSize="12"
                               TextWrapping="Wrap" Style="{StaticResource PropertyValueTextStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static loc:Strings.Common_Server}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CertServer}" Style="{StaticResource PropertyValueTextStyle}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static loc:Strings.Common_Thumbprint}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CertThumbprint}" FontFamily="Consolas, Cascadia Mono"
                               FontSize="11" Style="{StaticResource PropertyValueTextStyle}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static loc:Strings.X_Validity}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CertExpiry}" Style="{StaticResource PropertyValueTextStyle}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static loc:Strings.X_StoreLocation}" Style="{StaticResource PropertyLabelTextStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CertStoreText}" FontSize="12"
                               Style="{StaticResource PropertyValueTextStyle}"/>
                </Grid>
            </ui:Card>
            <TextBlock Text="{Binding CertError}" Foreground="#DC2626" FontSize="12" Margin="0,-12,0,16" TextWrapping="Wrap"
                       Visibility="{Binding CertError, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            <TextBlock Foreground="#D97706" FontSize="12" Margin="0,-12,0,16" TextWrapping="Wrap"
                       Text="{x:Static loc:Strings.X_TestCertWarning}"
                       Visibility="{Binding CertIsTest, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- SignTool 路径 -->
            <TextBlock Text="{x:Static loc:Strings.St_ToolPathLabel}" Style="{StaticResource SectionHeaderTextStyle}"/>
            <StackPanel Margin="0,0,0,12">
                <RadioButton Content="{x:Static loc:Strings.X_AutoDetect}" IsChecked="{Binding IsDiscoveredMode}" Margin="0,0,0,8"/>
                <StackPanel Margin="24,0,0,12" IsEnabled="{Binding IsDiscoveredMode}">
                    <ComboBox ItemsSource="{Binding DiscoveredTools}" SelectedItem="{Binding SelectedTool}"
                              DisplayMemberPath="DisplayName" MinWidth="400" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DiscoveryText}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <RadioButton Content="{x:Static loc:Strings.X_CustomPath}" IsChecked="{Binding IsCustomMode}" Margin="0,0,0,8"/>
                <Grid Margin="24,0,0,12" IsEnabled="{Binding IsCustomMode}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Text="{Binding CustomPath, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{x:Static loc:Strings.X_ToolPathPlaceholder}"/>
                    <ui:Button Grid.Column="1" Content="{x:Static loc:Strings.X_Browse}" Margin="8,0,0,0" Command="{Binding BrowseToolCommand}"/>
                </Grid>

                <RadioButton Content="{x:Static loc:Strings.X_UsePath}" IsChecked="{Binding IsPathMode}" Margin="0,0,0,4"/>
                <TextBlock Margin="24,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{x:Static loc:Strings.X_PathNote}"/>
            </StackPanel>
            <TextBlock Text="{Binding ToolError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding ToolError, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ToolHint}" Foreground="#D97706" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding ToolHint, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

            <!-- 待签名文件 -->
            <TextBlock Text="{x:Static loc:Strings.X_FileToSign}" Style="{StaticResource SectionHeaderTextStyle}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding TargetFile, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{x:Static loc:Strings.X_TargetPlaceholder}"/>
                <ui:Button Grid.Column="1" Content="{x:Static loc:Strings.X_BrowseFile}" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}"/>
            </Grid>
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="{x:Static loc:Strings.X_SingleFileNote}"/>
            <TextBlock Text="{Binding TargetError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding TargetError, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            <TextBlock Text="{Binding TargetHint}" Foreground="#D97706" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding TargetHint, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

            <!-- 签名选项 -->
            <TextBlock Text="{x:Static loc:Strings.X_SigningOptions}" Style="{StaticResource SectionHeaderTextStyle}"/>
            <TextBlock Text="{x:Static loc:Strings.X_DigestSha256}" FontSize="13" Margin="0,0,0,8"/>
            <CheckBox Content="{x:Static loc:Strings.X_UseTimestamp}" IsChecked="{Binding UseTimestamp}" Margin="0,0,0,8"/>
            <ui:TextBox Text="{Binding TimestampUrl, UpdateSourceTrigger=PropertyChanged}" Margin="24,0,0,4"
                        PlaceholderText="http://timestamp.digicert.com"
                        IsEnabled="{Binding UseTimestamp}"/>
            <TextBlock Text="{Binding TimestampError}" Foreground="#DC2626" FontSize="12" Margin="24,0,0,4" TextWrapping="Wrap"
                       Visibility="{Binding TimestampError, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
            <CheckBox Content="{x:Static loc:Strings.X_Verbose}" IsChecked="{Binding Verbose}" Margin="0,8,0,0"/>

        </StackPanel>

            <!-- 命令预览：等宽、可选择、横向滚动，不插入换行 -->
            <TextBlock Text="{x:Static loc:Strings.X_CommandPreviewCmd}" Style="{StaticResource SectionHeaderTextStyle}"/>
            <Border BorderThickness="1" CornerRadius="4" Padding="12,10"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent" Padding="0,0,0,6"
                         FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                         AutomationProperties.Name="{x:Static loc:Strings.X_CommandPreview}"/>
            </Border>

            <!-- 执行结果：只在点击「执行签名」后显示 -->
            <StackPanel Margin="0,16,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RunStatus}" Value="None">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ui:SymbolIcon FontSize="16" Margin="0,0,8,0" Filled="True">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RunStatus}" Value="Succeeded">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RunStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Symbol" Value="ErrorCircle24"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="{Binding RunMessage}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="620"/>
                </StackPanel>
                <!-- SignTool 原始输出：固定最大高度，超出时在框内滚动，不撑高对话框 -->
                <Border BorderThickness="1" CornerRadius="4" Padding="12,10"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Visibility="{Binding RunOutput, Converter={StaticResource StringEmptyToVisibilityConverter}}">
                    <TextBox Text="{Binding RunOutput, Mode=OneWay}" IsReadOnly="True" MaxHeight="160"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                             AutomationProperties.Name="{x:Static loc:Strings.X_SignToolOutput}"/>
                </Border>
            </StackPanel>
    </StackPanel>
</UserControl>
