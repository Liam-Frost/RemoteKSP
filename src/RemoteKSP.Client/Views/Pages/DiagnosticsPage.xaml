<Page x:Class="RemoteKSP.Client.Views.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:RemoteKSP.Client.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Target selection + action -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="{x:Static loc:Strings.Common_Server}" FontSize="13" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ViewModel.Servers, RelativeSource={RelativeSource AncestorType=Page}}"
                          SelectedItem="{Binding ViewModel.SelectedServer, RelativeSource={RelativeSource AncestorType=Page}}"
                          DisplayMemberPath="ServerName"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="{x:Static loc:Strings.X_Certificate}" FontSize="13" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ViewModel.Certificates, RelativeSource={RelativeSource AncestorType=Page}}"
                          SelectedItem="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}}"
                          DisplayMemberPath="Name"/>
            </StackPanel>
            <ui:Button Grid.Column="2"
                       Content="{x:Static loc:Strings.X_RunTests}"
                       Icon="{ui:SymbolIcon Play24}"
                       Appearance="Primary"
                       VerticalAlignment="Bottom"
                       Command="{Binding ViewModel.RunTestsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                       IsEnabled="{Binding ViewModel.IsTesting, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolConverter}}"/>
        </Grid>

        <!-- Status InfoBar - Fixed: Use Title and Message -->
        <ui:InfoBar Grid.Row="1"
                    IsOpen="{Binding ViewModel.IsTesting, RelativeSource={RelativeSource AncestorType=Page}}"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0,0,0,12"
                    Title="{x:Static loc:Strings.X_Testing}"
                    Message="{Binding ViewModel.Summary, RelativeSource={RelativeSource AncestorType=Page}}"/>

        <!-- Results Area - Fixed: Card needs BOTH VerticalAlignment AND VerticalContentAlignment -->
        <Border Grid.Row="2"
                Visibility="{Binding ViewModel.TestResults.Count, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource CountToVisibilityConverter}}">
            <ui:Card Padding="0"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Stretch">
                <ListBox ItemsSource="{Binding ViewModel.TestResults, RelativeSource={RelativeSource AncestorType=Page}}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,16">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status Icon - Fixed: Use SymbolIcon instead of clipped text -->
                                <ui:SymbolIcon Grid.Column="0"
                                               FontSize="24"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Top">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Question24"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Pass">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Warn">
                                                    <Setter Property="Symbol" Value="Warning24"/>
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Fail">
                                                    <Setter Property="Symbol" Value="DismissCircle24"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Outcome}" Value="Skip">
                                                    <Setter Property="Symbol" Value="SubtractCircle24"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>
        </Border>

        <!-- Empty State -->
        <Border Grid.Row="2"
                Visibility="{Binding ViewModel.TestResults.Count, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.X_DiagHint}" FontSize="14" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.X_DiagHint2}"
                           FontSize="12" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
