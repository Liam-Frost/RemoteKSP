<Page x:Class="RemoteKSP.Client.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:RemoteKSP.Client.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <ui:Button Content="{x:Static loc:Strings.Srv_AddTitle}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Left"
                       Command="{Binding ViewModel.ShowAddServerDialogCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            <ui:Button Content="{x:Static loc:Strings.X_Refresh}" Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Right"
                       Command="{Binding ViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Server List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ViewModel.HasServers, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ui:Card Padding="0" VerticalAlignment="Top">
                    <DataGrid ItemsSource="{Binding ViewModel.Servers, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedServer, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="400"
                              GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.Srv_Name}" Width="200" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.Srv_Address}" Binding="{Binding Url}" Width="260"/>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.X_Status}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding StatusIcon}" FontSize="16" Margin="0,0,6,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Critical">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Caution">
                                                                <Setter Property="Foreground" Value="#CA8A04"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Neutral">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Critical">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Caution">
                                                                <Setter Property="Foreground" Value="#CA8A04"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Neutral">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.X_CertificateCount}" Binding="{Binding CertificateCountText}" Width="90"/>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.Common_ClientId}" Width="*" MinWidth="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClientId}"
                                                   FontFamily="Consolas, Cascadia Mono"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ClientId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ViewModel.HasServers, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ui:SymbolIcon Symbol="Server24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.X_NoServers}" FontSize="14" Margin="0,16,0,8" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Static loc:Strings.X_NoServersHint}"
                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Action Bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0"
                Visibility="{Binding ViewModel.HasServers, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ui:Button Content="{x:Static loc:Strings.X_UpdateCertificates}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Margin="0,0,8,0"
                           Command="{Binding ViewModel.SyncCertificatesCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                <ui:Button Content="{x:Static loc:Strings.X_Rename}" Margin="0,0,8,0"
                           Command="{Binding ViewModel.RenameCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                <ui:Button Content="{x:Static loc:Strings.Srv_RemoveTitle}"
                           Command="{Binding ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
