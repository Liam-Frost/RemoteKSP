<Page x:Class="RemoteKSP.Client.Views.Pages.CertificatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:RemoteKSP.Client.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
      ScrollViewer.CanContentScroll="False">
    <!-- 页面自己滚动，不让 NavigationView 再包一层 DynamicScrollViewer（原因见服务端 SettingsPage.xaml） -->

    <Page.Resources>
        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Caution">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Caution">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Synchronization Progress (visible only when syncing) -->
        <ui:InfoBar Grid.Row="0"
                    IsOpen="{Binding ViewModel.IsSyncing, RelativeSource={RelativeSource AncestorType=Page}}"
                    Severity="Informational"
                    IsClosable="False"
                    Margin="0,0,0,16"
                    Title="{x:Static loc:Strings.X_Syncing}"
                    Message="{x:Static loc:Strings.X_SyncingMessage}"/>

        <!-- Row 1: Content Area (scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 服务端停用的证书（PIN 错误或 eToken 已锁）：签名会失败，需服务端管理员处理 -->
                <ui:InfoBar Severity="Error" IsClosable="False" Margin="0,0,0,16"
                            Title="{x:Static loc:Strings.X_SomeDisabled}"
                            Message="{Binding ViewModel.DisabledSummary, RelativeSource={RelativeSource AncestorType=Page}}"
                            IsOpen="{Binding ViewModel.HasDisabled, RelativeSource={RelativeSource AncestorType=Page}}"/>

                <!-- Certificate Table -->
                <ui:Card Padding="0" VerticalAlignment="Top"
                         Visibility="{Binding ViewModel.HasCertificates, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid ItemsSource="{Binding ViewModel.Certificates, RelativeSource={RelativeSource AncestorType=Page}}"
                              SelectedItem="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" MaxHeight="340"
                              GridLinesVisibility="None" HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.Srv_Name}" Width="220" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.Common_Server}" Binding="{Binding ServerText}" Width="160"/>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.X_Status}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StateBadgeStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StateBadgeTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.X_ValidUntil}" Binding="{Binding ExpiryText}" Width="110"/>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.Common_Thumbprint}" Width="*" MinWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Thumbprint}"
                                                   FontFamily="Consolas, Cascadia Mono"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Thumbprint}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </ui:Card>

                <!-- Empty State -->
                <Border MinHeight="300"
                        Visibility="{Binding ViewModel.HasCertificates, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Certificate24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{x:Static loc:Strings.X_NoCertificates}" FontSize="14" Margin="0,16,0,8" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Static loc:Strings.X_NoCertificatesHint}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Selected certificate details -->
                <ui:Card Padding="20" Margin="0,16,0,0"
                         Visibility="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid DataContext="{Binding ViewModel.SelectedCertificate, RelativeSource={RelativeSource AncestorType=Page}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.X_DisabledReason}" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,8,0,0"
                                   Visibility="{Binding IsServerDisabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisabledReason}" Foreground="#B91C1C"
                                   Style="{StaticResource PropertyValueTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding IsServerDisabled, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Row="0" Text="{x:Static loc:Strings.X_Subject}" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subject}" Style="{StaticResource PropertyValueTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.X_Issuer}" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Issuer}" Style="{StaticResource PropertyValueTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.Common_Server}" Style="{StaticResource PropertyLabelTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServerText}" Style="{StaticResource PropertyValueTextStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.Common_Thumbprint}" Style="{StaticResource PropertyLabelTextStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Thumbprint, Mode=OneWay}" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" Padding="0"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"/>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Action Bar (fixed at bottom) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <WrapPanel HorizontalAlignment="Left">
                    <ui:Button Content="{x:Static loc:Strings.X_UpdateAll}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Margin="0,0,8,0"
                               Command="{Binding ViewModel.SyncAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    <ui:Button Content="{x:Static loc:Strings.X_GenerateCommand}" Margin="0,0,8,0"
                               Command="{Binding ViewModel.GenerateSignCommandCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                               Icon="{ui:SymbolIcon DocumentBulletListClock24}"/>
                    <ui:Button Content="{x:Static loc:Strings.Certs_UnbindTitle}"
                               Command="{Binding ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                </WrapPanel>
                <ui:Button Content="{x:Static loc:Strings.X_Refresh}" Icon="{ui:SymbolIcon ArrowSync24}" HorizontalAlignment="Right"
                           Command="{Binding ViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
