<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>RemoteKSP.Shared</AssemblyName>
    <RootNamespace>RemoteKSP.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!-- UI text: SharedStrings.resx is English, SharedStrings.<culture>.resx are translations.
       SharedStrings.Designer.cs is regenerated by Visual Studio / Rider when the .resx changes. -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\SharedStrings.resx"
                      Generator="PublicResXFileCodeGenerator" LastGenOutput="SharedStrings.Designer.cs" />
    <Compile Update="Localization\SharedStrings.Designer.cs"
             DesignTime="True" AutoGen="True" DependentUpon="SharedStrings.resx" />
    <Using Include="RemoteKSP.Shared.Localization" />
  </ItemGroup>
</Project>
