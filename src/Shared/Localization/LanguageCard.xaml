<UserControl x:Class="RemoteKSP.Shared.Localization.LanguageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:RemoteKSP.Shared.Localization">
    <!-- DataContext is a LanguageSettingsViewModel -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LangBoolToVisibility"/>
    </UserControl.Resources>
    <ui:Card Padding="24">
        <StackPanel>
            <TextBlock Text="{x:Static loc:SharedStrings.Lang_Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <ComboBox Width="220" HorizontalAlignment="Left"
                      AutomationProperties.Name="{x:Static loc:SharedStrings.Lang_Title}"
                      ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                      DisplayMemberPath="DisplayName"/>
            <TextBlock Text="{x:Static loc:SharedStrings.Lang_Description}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding RestartRequired, Converter={StaticResource LangBoolToVisibility}}">
                <ui:SymbolIcon Symbol="Info16" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{x:Static loc:SharedStrings.Lang_RestartPrompt}" FontSize="13" Margin="8,0,16,0"
                           VerticalAlignment="Center"/>
                <ui:Button Content="{x:Static loc:SharedStrings.Lang_RestartNow}" Appearance="Primary"
                           Command="{Binding RestartCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ui:Card>
</UserControl>
