<UserControl x:Class="RemoteKSP.Shared.Networking.NetworkAddressesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:net="clr-namespace:RemoteKSP.Shared.Networking"
             x:Name="Root">
    <UserControl.Resources>
        <!-- 一行地址：地址 + 属性在左（可省略），复制按钮在右。按钮列用 SharedSizeGroup，所有行的按钮右对齐成一列 -->
        <DataTemplate x:Key="AddressRowTemplate" DataType="{x:Type net:NetworkAddressItem}">
            <Grid MinHeight="32" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AddressActions"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}">
                    <Run Text="{Binding AddressText, Mode=OneWay}" FontSize="14"
                         FontFamily="Cascadia Mono, Consolas, Courier New"/>
                    <Run Text="{Binding MetaText, Mode=OneWay, StringFormat={}  {0}}" FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="12,0,0,0">
                    <ui:Button Content="复制 IP" Icon="{ui:SymbolIcon Copy20}" Style="{StaticResource SubtleButtonStyle}"
                               ToolTip="{Binding AddressText}"
                               Command="{Binding DataContext.CopyAddressCommand, ElementName=Root}"
                               CommandParameter="{Binding}"/>
                    <ui:Button Content="复制连接地址" Icon="{ui:SymbolIcon Link20}" Style="{StaticResource SubtleButtonStyle}"
                               Margin="4,0,0,0"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding ServerUrlToolTip}"
                               Visibility="{Binding HasServerUrl, Converter={StaticResource BoolToVisibilityConverter}}"
                               Command="{Binding DataContext.CopyUrlCommand, ElementName=Root}"
                               CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 一个网络接口：接口名只出现一次，下面是它的地址 -->
        <DataTemplate x:Key="InterfaceGroupTemplate" DataType="{x:Type net:NetworkInterfaceGroup}">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                <ItemsControl ItemsSource="{Binding Addresses}" ItemTemplate="{StaticResource AddressRowTemplate}"
                              Focusable="False"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ui:Card Padding="20" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：标题 + 信息图标（详细说明在 ToolTip 里）+ 刷新 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource CardHeaderTextStyle}"
                                   VerticalAlignment="Center"/>
                        <!-- 透明背景让整个 20×20 区域都能悬停；可获得键盘焦点，焦点时同样显示说明 -->
                        <Border Width="20" Height="20" Margin="4,0,0,0" VerticalAlignment="Center"
                                Background="Transparent" Focusable="True" CornerRadius="4"
                                AutomationProperties.Name="网络说明"
                                AutomationProperties.HelpText="{Binding FootnoteDetail}"
                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                            <Border.ToolTip>
                                <ToolTip MaxWidth="420">
                                    <TextBlock Text="{Binding FootnoteDetail}" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Border.ToolTip>
                            <ui:SymbolIcon Symbol="Info16" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Footnote}" Style="{StaticResource MetricDetailTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="1" Content="刷新" Icon="{ui:SymbolIcon ArrowSync20}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- 读取失败：保留上次结果，同时显示真实错误 -->
            <TextBlock Grid.Row="1" Text="{Binding ErrorText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>

            <!-- 按接口分组的地址 -->
            <StackPanel Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource InterfaceGroupTemplate}"
                              Focusable="False"
                              Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="{Binding EmptyText}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasAddresses, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 其他网络地址：Fluent 展开按钮（Chevron），N 为隐藏的地址条数 -->
            <ui:Button Grid.Row="3" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" HorizontalAlignment="Left"
                       Command="{Binding ToggleOtherCommand}"
                       Visibility="{Binding HasHidden, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ToggleText}" FontSize="13" VerticalAlignment="Center"/>
                    <ui:SymbolIcon FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="ChevronDown16"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowOther}" Value="True">
                                        <Setter Property="Symbol" Value="ChevronUp16"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </StackPanel>
            </ui:Button>
        </Grid>
    </ui:Card>
</UserControl>
