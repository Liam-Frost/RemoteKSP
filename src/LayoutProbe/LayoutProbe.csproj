<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev-only layout probe. Not referenced by any shipping project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>LayoutProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteKSP.Server\RemoteKSP.Server.csproj" />
    <ProjectReference Include="..\RemoteKSP.Client\RemoteKSP.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- MainWindow 的 pack://application:,,,/Assets/RemoteKSP.ico 按入口程序集解析，probe 需要同名资源 -->
    <Resource Include="..\Shared\LOGO\RemoteKSP.ico">
      <Link>Assets\RemoteKSP.ico</Link>
    </Resource>
  </ItemGroup>
</Project>
